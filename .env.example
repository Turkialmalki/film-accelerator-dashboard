# Film Business Accelerator — environment variables
#
# Copy to .env.local for local development, or set these in the Vercel project.
# .env* is gitignored; never commit a filled-in copy.
#
# EVERY VARIABLE HERE IS OPTIONAL. With none of them set the application runs
# in demo mode against localStorage, which is the documented default.

# --------------------------------------------------------------- Supabase ---
# Set BOTH of these to leave demo mode. Setting only one keeps the app in demo
# mode — the detection lives in lib/supabase/env.ts and is used by the data
# layer, the auth layer and middleware alike.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The `organizations.id` this deployment serves. Defaults to the demo id
# `org_fba`; set it to the real UUID once the organisation row is seeded.
NEXT_PUBLIC_ORG_ID=

# SERVER ONLY. Never prefix this with NEXT_PUBLIC_ and never read it from a
# client component. It bypasses Row Level Security completely — whoever holds
# it owns the database. It is used by exactly two things:
#
#   app/api/admin/invite/route.ts        creating invited users
#   app/api/auth/change-password/route.ts clearing the must_change_password gate
#   scripts/bootstrap-admin.mjs          the one-time first-admin CLI tool
#
# Both routes reach it through lib/data/supabase-admin.ts, which is marked
# `server-only` so the build fails if a client bundle ever imports it.
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------- Resend ---
# Transactional email for admin invitations. Unset means invitations still
# create the account, but the temporary password is returned to the inviting
# admin in the UI instead of being emailed.
RESEND_API_KEY=

# The From address. Must be on a domain verified in Resend. If unset the code
# falls back to the Resend sandbox sender `onboarding@resend.dev` and logs a
# warning — that sender can only deliver to the Resend account owner's own
# address, so it is a smoke test, not a production setting.
RESEND_FROM_EMAIL=

# ------------------------------------------------------------- Calendly -----
# Personal access token, Integrations & API -> API & Webhooks in Calendly.
# Server only — never exposed to the client. Powers the "Mentorship sessions"
# dashboard panel (on-demand sync against Calendly's REST API; no webhook).
# If unset, that panel shows a clear "not connected" state instead of zeros.
CALENDLY_API_TOKEN=

# ------------------------------------------------------------------ Misc ----
# Absolute origin used to build the sign-in link inside invitation emails.
# Falls back to the request origin, which is correct on Vercel; set it if the
# app sits behind a proxy that rewrites the host.
NEXT_PUBLIC_SITE_URL=

# Path to the approved campaign photograph for the auth panel. Unset uses
# public/brand/campaign-fba.jpg.
NEXT_PUBLIC_CAMPAIGN_IMAGE=
